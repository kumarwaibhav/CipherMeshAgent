# Bind to loopback by default. Do not expose plain TCP directly to the internet.
CIPHERMESH_HOST=127.0.0.1
CIPHERMESH_PORT=9052
CIPHERMESH_MAX_BYTES=65536
CIPHERMESH_MAX_WORKERS=32
# Use the same value for server and client; generate a unique local demo token.
CIPHERMESH_SHARED_TOKEN=replace-with-a-long-random-local-demo-token
