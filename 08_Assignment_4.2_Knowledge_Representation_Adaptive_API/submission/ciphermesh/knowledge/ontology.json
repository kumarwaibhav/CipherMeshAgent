 "@id": "cm:ontology",
 "@type": "owl:Ontology",
 "owl:versionInfo": "4.2.0",
 "dcterms:title": "CipherMesh domain ontology (providers, jurisdictions, data categories, policy, threats, live feeds)",
 "dcterms:creator": "Kumar Waibhav Akshat (RA2212704010027)",
 "dcterms:modified": "2026-10-31",
 "@graph": [
  {
   "@id": "cm:Resource",
   "@type": "owl:Class",
   "label": "Resource",
   "comment": "Root class of every CipherMesh knowledge item."
  },
  {
   "@id": "cm:Provider",
   "@type": "owl:Class",
   "label": "Provider",
   "comment": "An AI inference endpoint the router can select.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:CloudProvider",
   "@type": "owl:Class",
   "label": "CloudProvider",
   "comment": "A managed provider in a public cloud region.",
   "subClassOf": "cm:Provider"
  },
  {
   "@id": "cm:LocalProvider",
   "@type": "owl:Class",
   "label": "LocalProvider",
   "comment": "An on-host model runtime (no network egress).",
   "subClassOf": "cm:Provider"
  },
  {
   "@id": "cm:Location",
   "@type": "owl:Class",
   "label": "Location",
   "comment": "Anything that has a geographic or legal position.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:CloudRegion",
   "@type": "owl:Class",
   "label": "CloudRegion",
   "comment": "A vendor data-centre region.",
   "subClassOf": "cm:Location"
  },
  {
   "@id": "cm:Jurisdiction",
   "@type": "owl:Class",
   "label": "Jurisdiction",
   "comment": "A legal territory (country, bloc or on-host).",
   "subClassOf": "cm:Location"
  },
  {
   "@id": "cm:Vendor",
   "@type": "owl:Class",
   "label": "Vendor",
   "comment": "An organisation or software project.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:DataCategory",
   "@type": "owl:Class",
   "label": "DataCategory",
   "comment": "One of the 25 detector categories.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:DetectorFamily",
   "@type": "owl:Class",
   "label": "DetectorFamily",
   "comment": "A detector family D1-D12.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:LegalInstrument",
   "@type": "owl:Class",
   "label": "LegalInstrument",
   "comment": "A law, regulation or organisational policy.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:Regulation",
   "@type": "owl:Class",
   "label": "Regulation",
   "comment": "A statute or binding regulation.",
   "subClassOf": "cm:LegalInstrument"
  },
  {
   "@id": "cm:OrganisationalPolicy",
   "@type": "owl:Class",
   "label": "OrganisationalPolicy",
   "comment": "A CipherMesh policy that interprets regulation.",
   "subClassOf": "cm:LegalInstrument"
  },
  {
   "@id": "cm:ResidencyPolicy",
   "@type": "owl:Class",
   "label": "ResidencyPolicy",
   "comment": "A policy that limits where data may be processed.",
   "subClassOf": "cm:OrganisationalPolicy"
  },
  {
   "@id": "cm:PolicyRule",
   "@type": "owl:Class",
   "label": "PolicyRule",
   "comment": "A condition-action rule of the CipherMesh policy engine.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:Decision",
   "@type": "owl:Class",
   "label": "Decision",
   "comment": "ALLOW, REDACT, REVIEW or BLOCK.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:Threat",
   "@type": "owl:Class",
   "label": "Threat",
   "comment": "A way sensitive data can be exposed or misused.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:VulnerabilityClass",
   "@type": "owl:Class",
   "label": "VulnerabilityClass",
   "comment": "A class of exploitable weakness.",
   "subClassOf": "cm:Threat"
  },
  {
   "@id": "cm:Vulnerability",
   "@type": "owl:Class",
   "label": "Vulnerability",
   "comment": "A specific known-exploited vulnerability (live).",
   "subClassOf": "cm:Threat"
  },
  {
   "@id": "cm:ThreatPosture",
   "@type": "owl:Class",
   "label": "ThreatPosture",
   "comment": "Agent-wide threat level with its policy effects.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:InformationSource",
   "@type": "owl:Class",
   "label": "InformationSource",
   "comment": "Any external knowledge feed.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:StatusSource",
   "@type": "owl:Class",
   "label": "StatusSource",
   "comment": "Live provider health feed.",
   "subClassOf": "cm:InformationSource"
  },
  {
   "@id": "cm:ThreatFeed",
   "@type": "owl:Class",
   "label": "ThreatFeed",
   "comment": "Live security or AI-incident feed.",
   "subClassOf": "cm:InformationSource"
  },
  {
   "@id": "cm:MarketDataFeed",
   "@type": "owl:Class",
   "label": "MarketDataFeed",
   "comment": "Live market data feed (exchange rates).",
   "subClassOf": "cm:InformationSource"
  },
  {
   "@id": "cm:Currency",
   "@type": "owl:Class",
   "label": "Currency",
   "comment": "An ISO 4217 currency.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:ExchangeRate",
   "@type": "owl:Class",
   "label": "ExchangeRate",
   "comment": "A currency conversion rate (live).",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:ProviderStatus",
   "@type": "owl:Class",
   "label": "ProviderStatus",
   "comment": "Operational status value with routing effects.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:Incident",
   "@type": "owl:Class",
   "label": "Incident",
   "comment": "A live incident record from a status feed.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:AgentProfile",
   "@type": "owl:Class",
   "label": "AgentProfile",
   "comment": "Settings of the CipherMesh agent itself.",
   "subClassOf": "cm:Resource"
  },
  {
   "@id": "cm:hostedIn",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "hostedIn",
   "comment": "A provider endpoint is served from exactly one region.",
   "domain": "cm:Provider",
   "range": "cm:CloudRegion"
  },
  {
   "@id": "cm:locatedIn",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "locatedIn",
   "comment": "The legal jurisdiction where a region stores and processes data.",
   "domain": "cm:CloudRegion",
   "range": "cm:Jurisdiction"
  },
  {
   "@id": "cm:operatedBy",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "operatedBy",
   "comment": "Organisation that runs the provider service or software.",
   "domain": "cm:Provider",
   "range": "cm:Vendor"
  },
  {
   "@id": "cm:monitoredBy",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "monitoredBy",
   "comment": "Public live feed that reports the provider's health.",
   "domain": "cm:Provider",
   "range": "cm:StatusSource"
  },
  {
   "@id": "cm:priceCurrency",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "priceCurrency",
   "comment": "Currency in which the provider's list price is quoted.",
   "domain": "cm:Provider",
   "range": "cm:Currency"
  },
  {
   "@id": "cm:hasStatus",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "hasStatus",
   "comment": "Current operational status (updated from live feeds).",
   "domain": "cm:Provider",
   "range": "cm:ProviderStatus"
  },
  {
   "@id": "cm:memberOf",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "memberOf",
   "comment": "Detector family (D1-D12) that a category belongs to.",
   "domain": "cm:DataCategory",
   "range": "cm:DetectorFamily"
  },
  {
   "@id": "cm:triggersRule",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "triggersRule",
   "comment": "Policy rule that fires when the category is found.",
   "domain": "cm:DataCategory",
   "range": "cm:PolicyRule"
  },
  {
   "@id": "cm:yieldsDecision",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "yieldsDecision",
   "comment": "Decision produced by the rule.",
   "domain": "cm:PolicyRule",
   "range": "cm:Decision"
  },
  {
   "@id": "cm:precedes",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "precedes",
   "comment": "Strictest-wins ordering between rules.",
   "domain": "cm:PolicyRule",
   "range": "cm:PolicyRule"
  },
  {
   "@id": "cm:governedBy",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "governedBy",
   "comment": "Law or organisational policy that applies to a category or family.",
   "domain": "cm:Resource",
   "range": "cm:LegalInstrument"
  },
  {
   "@id": "cm:basedOn",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "basedOn",
   "comment": "Statute that an organisational policy interprets.",
   "domain": "cm:OrganisationalPolicy",
   "range": "cm:Regulation"
  },
  {
   "@id": "cm:requiresResidency",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "requiresResidency",
   "comment": "Jurisdictions where governed data may be processed.",
   "domain": "cm:ResidencyPolicy",
   "range": "cm:Jurisdiction"
  },
  {
   "@id": "cm:appliesIn",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "appliesIn",
   "comment": "Territorial scope of a regulation.",
   "domain": "cm:Regulation",
   "range": "cm:Jurisdiction"
  },
  {
   "@id": "cm:mitigatedBy",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "mitigatedBy",
   "comment": "Control (rule or policy) that mitigates a threat.",
   "domain": "cm:Threat",
   "range": "cm:Resource"
  },
  {
   "@id": "cm:watchesVendor",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "watchesVendor",
   "comment": "Vendor whose products are counted as relevant to CipherMesh.",
   "domain": "cm:ThreatFeed",
   "range": "cm:Vendor"
  },
  {
   "@id": "cm:hasPosture",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "hasPosture",
   "comment": "Current threat posture of the agent (derived from live feeds).",
   "domain": "cm:AgentProfile",
   "range": "cm:ThreatPosture"
  },
  {
   "@id": "cm:budgetCurrency",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "budgetCurrency",
   "comment": "Currency of the organisation's routing budget.",
   "domain": "cm:AgentProfile",
   "range": "cm:Currency"
  },
  {
   "@id": "cm:fromCurrency",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "fromCurrency",
   "comment": "Base currency of an exchange rate.",
   "domain": "cm:ExchangeRate",
   "range": "cm:Currency"
  },
  {
   "@id": "cm:toCurrency",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "toCurrency",
   "comment": "Quote currency of an exchange rate.",
   "domain": "cm:ExchangeRate",
   "range": "cm:Currency"
  },
  {
   "@id": "cm:affectsRegion",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "affectsRegion",
   "comment": "Region named in a live incident report.",
   "domain": "cm:Incident",
   "range": "cm:CloudRegion"
  },
  {
   "@id": "cm:affectsProvider",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "affectsProvider",
   "comment": "CipherMesh provider affected by a live incident.",
   "domain": "cm:Incident",
   "range": "cm:Provider"
  },
  {
   "@id": "cm:reportedBy",
   "@type": [
    "owl:ObjectProperty",
    "owl:FunctionalProperty"
   ],
   "label": "reportedBy",
   "comment": "Feed that reported the incident or record.",
   "domain": "cm:Incident",
   "range": "cm:InformationSource"
  },
  {
   "@id": "cm:affectsVendor",
   "@type": [
    "owl:ObjectProperty"
   ],
   "label": "affectsVendor",
   "comment": "Vendor named in a known-exploited vulnerability record.",
   "domain": "cm:Vulnerability",
   "range": "cm:Vendor"
  },
  {
   "@id": "cm:providerId",
   "@type": "owl:DatatypeProperty",
   "label": "providerId",
   "comment": "Identifier used by the routing engine (providers.py).",
   "domain": "cm:Provider",
   "range": "xsd:string"
  },
  {
   "@id": "cm:kind",
   "@type": "owl:DatatypeProperty",
   "label": "kind",
   "comment": "cloud or local.",
   "domain": "cm:Provider",
   "range": "xsd:string"
  },
  {
   "@id": "cm:costPer1kUsd",
   "@type": "owl:DatatypeProperty",
   "label": "costPer1kUsd",
   "comment": "Illustrative list price per 1,000 requests (USD).",
   "domain": "cm:Provider",
   "range": "xsd:decimal"
  },
  {
   "@id": "cm:p95LatencyMs",
   "@type": "owl:DatatypeProperty",
   "label": "p95LatencyMs",
   "comment": "Illustrative p95 latency in milliseconds.",
   "domain": "cm:Provider",
   "range": "xsd:decimal"
  },
  {
   "@id": "cm:qualityScore",
   "@type": "owl:DatatypeProperty",
   "label": "qualityScore",
   "comment": "Illustrative quality score on a 0-5 scale.",
   "domain": "cm:Provider",
   "range": "xsd:decimal"
  },
  {
   "@id": "cm:availabilityPct",
   "@type": "owl:DatatypeProperty",
   "label": "availabilityPct",
   "comment": "Illustrative availability percentage.",
   "domain": "cm:Provider",
   "range": "xsd:decimal"
  },
  {
   "@id": "cm:serviceAlias",
   "@type": "owl:DatatypeProperty",
   "label": "serviceAlias",
   "comment": "Service names used for this provider in vendor status feeds.",
   "domain": "cm:Provider",
   "range": "xsd:string"
